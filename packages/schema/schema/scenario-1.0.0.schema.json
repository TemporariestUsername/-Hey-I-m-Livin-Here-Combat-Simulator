{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-here.example/schema/scenario-1.0.0.schema.json",
  "title": "Living Here Scenario 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "seed", "pulseMs", "maxTicks", "map", "threat", "actors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "pulseMs": { "const": 100 },
    "maxTicks": { "type": "integer", "minimum": 1, "maximum": 36000 },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 1, "maximum": 1000 },
        "height": { "type": "number", "minimum": 1, "maximum": 1000 },
        "obstacles": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/rectangle" }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "endsAtTick": { "type": "integer", "minimum": 1, "maximum": 36000 }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/actor" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "blocksVision": { "type": "boolean" },
        "blocksMovement": { "type": "boolean" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "position", "readiness", "stamina", "resolve"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/id" },
        "position": { "$ref": "#/$defs/point" },
        "facingDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
        "visionRange": { "type": "number", "minimum": 0, "maximum": 1000 },
        "visionArcDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
        "movementSpeed": { "type": "number", "minimum": 0, "maximum": 10 },
        "readiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "stamina": { "type": "number", "minimum": 0, "maximum": 1 },
        "resolve": { "type": "number", "minimum": 0, "maximum": 1 },
        "threatened": { "type": "boolean" },
        "policyId": { "enum": ["safety-first", "random-valid"] }
      }
    }
  }
}
