{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-here.example/schema/scenario-1.1.0.schema.json",
  "title": "Living Here Scenario 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "seed", "pulseMs", "maxTicks", "map", "threat", "actors"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "pulseMs": { "const": 100 },
    "maxTicks": { "type": "integer", "minimum": 1, "maximum": 36000 },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 1, "maximum": 1000 },
        "height": { "type": "number", "minimum": 1, "maximum": 1000 },
        "obstacles": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/rectangle" }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "endsAtTick": { "type": "integer", "minimum": 1, "maximum": 36000 }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physics": { "$ref": "#/$defs/physicsRules" }
      }
    },
    "objectives": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/objective" }
    },
    "terminalConditions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/terminalCondition" }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/actor" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "blocksVision": { "type": "boolean" },
        "blocksMovement": { "type": "boolean" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "position", "readiness", "stamina", "resolve"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/id" },
        "position": { "$ref": "#/$defs/point" },
        "facingDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
        "visionRange": { "type": "number", "minimum": 0, "maximum": 1000 },
        "visionArcDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
        "movementSpeed": { "type": "number", "minimum": 0, "maximum": 10 },
        "massKg": { "type": "number", "minimum": 35, "maximum": 200 },
        "radiusM": { "type": "number", "minimum": 0.15, "maximum": 0.75 },
        "skill": { "type": "number", "minimum": 0, "maximum": 1 },
        "balance": { "type": "number", "minimum": 0, "maximum": 1 },
        "guard": { "type": "number", "minimum": 0, "maximum": 1 },
        "mobility": { "type": "number", "minimum": 0, "maximum": 1 },
        "surprise": { "type": "number", "minimum": 0, "maximum": 1 },
        "reachM": { "type": "number", "minimum": 0.2, "maximum": 3 },
        "protection": { "type": "number", "minimum": 0, "maximum": 1 },
        "stance": { "enum": ["neutral", "mobile", "guarded", "committed"] },
        "readiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "stamina": { "type": "number", "minimum": 0, "maximum": 1 },
        "resolve": { "type": "number", "minimum": 0, "maximum": 1 },
        "threatened": { "type": "boolean" },
        "policyId": { "enum": ["safety-first", "random-valid"] }
      }
    },
    "physicsRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interruptMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "tempoNoise": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "contactNoise": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "recoveryPerPulse": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "impairmentRecoveryPerPulse": { "type": "number", "minimum": 0, "maximum": 0.1 },
        "separationScaleM": { "type": "number", "minimum": 0, "maximum": 3 },
        "neutralizationThreshold": { "type": "number", "minimum": 0.5, "maximum": 1 }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["protect-side", "neutralize-side", "separation"] },
        "side": { "$ref": "#/$defs/id" },
        "actorIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/id" }
        },
        "minimumDistanceM": { "type": "number", "minimum": 0.5, "maximum": 1000 }
      }
    },
    "terminalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["threat-ended", "side-neutralized", "objective-complete"] },
        "side": { "$ref": "#/$defs/id" },
        "objectiveId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
