{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-here.example/schema/scenario-1.3.0.schema.json",
  "title": "Living Here Scenario 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "seed",
    "pulseMs",
    "maxTicks",
    "map",
    "threat",
    "actors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pulseMs": {
      "const": 100
    },
    "maxTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36000
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "obstacles": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/rectangle"
          }
        },
        "exits": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/exitZone"
          }
        },
        "navigableAreas": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/navigationArea"
          }
        },
        "environmentZones": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/environmentZone"
          }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "endsAtTick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36000
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "immediacy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retreatAvailable": {
          "type": "boolean"
        },
        "threatenedActorIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physics": {
          "$ref": "#/$defs/physicsRules"
        },
        "morale": {
          "$ref": "#/$defs/moraleRules"
        },
        "engagement": {
          "$ref": "#/$defs/engagementRules"
        }
      }
    },
    "squads": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/squad"
      }
    },
    "objectives": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "terminalConditions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/terminalCondition"
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scheduledEvents": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/scheduledEvent"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "blocksVision": {
          "type": "boolean"
        },
        "blocksMovement": {
          "type": "boolean"
        }
      }
    },
    "exitZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "squad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "initialCohesion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "leaderId": {
          "$ref": "#/$defs/id"
        },
        "initialCohesion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "position",
        "readiness",
        "stamina",
        "resolve"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "facingDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "visionRange": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "visionArcDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "movementSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "massKg": {
          "type": "number",
          "minimum": 35,
          "maximum": 200
        },
        "radiusM": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.75
        },
        "skill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "balance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "guard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mobility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surprise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reachM": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        "protection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stance": {
          "enum": [
            "neutral",
            "mobile",
            "guarded",
            "committed"
          ]
        },
        "readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stamina": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resolve": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fear": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aggression": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "squadId": {
          "$ref": "#/$defs/id"
        },
        "leader": {
          "type": "boolean"
        },
        "humanIntent": {
          "enum": [
            "observe",
            "communicate",
            "reposition",
            "protect",
            "withdraw",
            "ready-tool",
            "commit",
            "aid-ally",
            "rally",
            "wait"
          ]
        },
        "threatened": {
          "type": "boolean"
        },
        "policyId": {
          "enum": [
            "safety-first",
            "random-valid",
            "sportive",
            "chen-inspired",
            "human-intent"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "attention": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hearingRangeM": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "soundSignature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "awareness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tool": {
          "$ref": "#/$defs/abstractTool"
        },
        "humanTargetActorId": {
          "$ref": "#/$defs/id"
        },
        "humanTargetPoint": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "action": {
      "enum": [
        "observe",
        "communicate",
        "reposition",
        "protect",
        "withdraw",
        "ready-tool",
        "commit",
        "aid-ally",
        "rally",
        "wait"
      ]
    },
    "physicsRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interruptMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tempoNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "contactNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "recoveryPerPulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "impairmentRecoveryPerPulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "separationScaleM": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "neutralizationThreshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        }
      }
    },
    "moraleRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "shockRadiusM": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "shockFalloff": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "allyShockScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "leaderResistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cascadeDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "perPulseCap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shakenThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frozenThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "routeThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoverThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoveryPerPulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "protect-side",
            "neutralize-side",
            "separation",
            "evacuate-side"
          ]
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "actorIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "minimumDistanceM": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1000
        }
      }
    },
    "terminalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "threat-ended",
            "side-neutralized",
            "side-routed",
            "objective-complete"
          ]
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "objectiveId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "navigationArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "environmentZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "cover",
            "light",
            "noise"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambientLight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambientNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visibilityScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "scheduledEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tick",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36000
        },
        "kind": {
          "enum": [
            "threat-state",
            "environment"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "ambientLight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambientNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visibilityScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "abstractTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "reachM",
        "readiness",
        "concealment",
        "durability",
        "defensiveUtility",
        "intimidation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "class": {
          "enum": [
            "none",
            "barrier",
            "signal",
            "short-reach",
            "long-reach"
          ]
        },
        "reachM": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "concealment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "durability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "defensiveUtility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "intimidation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "engagementRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumSeverity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumImmediacy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requireThreatenedParty": {
          "type": "boolean"
        },
        "permitCommit": {
          "type": "boolean"
        },
        "permitProtect": {
          "type": "boolean"
        },
        "permitWithdrawal": {
          "type": "boolean"
        }
      }
    }
  }
}
