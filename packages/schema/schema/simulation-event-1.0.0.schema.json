{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-here.example/schema/simulation-event-1.0.0.schema.json",
  "title": "Living Here Simulation Event 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "tick", "type", "payload", "priorChecksum", "checksum"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sequence": { "type": "integer", "minimum": 0 },
    "tick": { "type": "integer", "minimum": 0 },
    "type": {
      "enum": [
        "simulation-started",
        "threat-ended",
        "observation-built",
        "policy-decided",
        "intent-gated",
        "intent-resolved",
        "movement-resolved",
        "simulation-ended"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenarioId", "seed"],
          "properties": {
            "scenarioId": { "$ref": "#/$defs/id" },
            "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 80 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["observerId", "visibleActorIds"],
          "properties": {
            "observerId": { "$ref": "#/$defs/id" },
            "visibleActorIds": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "policyId", "policyVersion", "selected", "candidates", "rationale", "rngSamples"],
          "properties": {
            "actorId": { "$ref": "#/$defs/id" },
            "policyId": { "$ref": "#/$defs/id" },
            "policyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "selected": { "$ref": "#/$defs/action" },
            "candidates": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/policyCandidate" }
            },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
            "rngSamples": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "proposed", "selected", "failedPredicate"],
          "properties": {
            "actorId": { "$ref": "#/$defs/id" },
            "proposed": { "$ref": "#/$defs/action" },
            "selected": { "$ref": "#/$defs/action" },
            "failedPredicate": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "selected", "stamina"],
          "properties": {
            "actorId": { "$ref": "#/$defs/id" },
            "selected": { "$ref": "#/$defs/action" },
            "stamina": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "from", "to", "blocked"],
          "properties": {
            "actorId": { "$ref": "#/$defs/id" },
            "from": { "$ref": "#/$defs/point" },
            "to": { "$ref": "#/$defs/point" },
            "blocked": { "type": "boolean" }
          }
        }
      ]
    },
    "priorChecksum": { "$ref": "#/$defs/checksum" },
    "checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": {
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "action": {
      "enum": ["observe", "communicate", "reposition", "protect", "withdraw", "ready-tool", "commit", "aid-ally", "rally", "wait"]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "policyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "eligible", "score", "contributions"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "eligible": { "type": "boolean" },
        "score": { "type": "number" },
        "contributions": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
