{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-here.example/schema/simulation-state-1.3.0.schema.json",
  "title": "Living Here Simulation State 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "tick",
    "elapsedMs",
    "threatActive",
    "done",
    "actors",
    "squads",
    "objectiveProgress",
    "environment",
    "randomStreams"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "scenarioId": {
      "$ref": "#/$defs/id"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36000
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "threatActive": {
      "type": "boolean"
    },
    "done": {
      "type": "boolean"
    },
    "terminalReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "objectiveProgress": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "squads": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/squadState"
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/actorState"
      }
    },
    "environment": {
      "$ref": "#/$defs/environmentState"
    },
    "randomStreams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensing",
        "movement",
        "contact",
        "morale",
        "policy"
      ],
      "properties": {
        "sensing": {
          "$ref": "#/$defs/randomStreamState"
        },
        "movement": {
          "$ref": "#/$defs/randomStreamState"
        },
        "contact": {
          "$ref": "#/$defs/randomStreamState"
        },
        "morale": {
          "$ref": "#/$defs/randomStreamState"
        },
        "policy": {
          "$ref": "#/$defs/randomStreamState"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "action": {
      "enum": [
        "observe",
        "communicate",
        "reposition",
        "protect",
        "withdraw",
        "ready-tool",
        "commit",
        "aid-ally",
        "rally",
        "wait"
      ]
    },
    "squadState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "cohesion",
        "routedCount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "leaderId": {
          "$ref": "#/$defs/id"
        },
        "cohesion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "routedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "actorState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "position",
        "readiness",
        "stamina",
        "resolve",
        "active",
        "intent",
        "shock",
        "balance",
        "guard",
        "mobility",
        "impairment",
        "disruption",
        "recoveryTicks",
        "neutralized",
        "fear",
        "moraleState",
        "escaped",
        "awareness",
        "memoryActorIds",
        "memoryAges",
        "toolReady",
        "toolAvailable",
        "engagementHeadroom"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "facingDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "visionRange": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "visionArcDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "movementSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "massKg": {
          "type": "number",
          "minimum": 35,
          "maximum": 200
        },
        "radiusM": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.75
        },
        "skill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "balance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "guard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mobility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surprise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reachM": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        "protection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stance": {
          "enum": [
            "neutral",
            "mobile",
            "guarded",
            "committed"
          ]
        },
        "readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stamina": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resolve": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fear": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aggression": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "squadId": {
          "$ref": "#/$defs/id"
        },
        "leader": {
          "type": "boolean"
        },
        "humanIntent": {
          "$ref": "#/$defs/action"
        },
        "threatened": {
          "type": "boolean"
        },
        "policyId": {
          "enum": [
            "safety-first",
            "random-valid",
            "sportive",
            "chen-inspired",
            "human-intent"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "attention": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hearingRangeM": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "soundSignature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "awareness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tool": {
          "$ref": "#/$defs/abstractTool"
        },
        "humanTargetActorId": {
          "$ref": "#/$defs/id"
        },
        "humanTargetPoint": {
          "$ref": "#/$defs/point"
        },
        "active": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/$defs/action"
        },
        "shock": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "impairment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disruption": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoveryTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "neutralized": {
          "type": "boolean"
        },
        "moraleState": {
          "enum": [
            "steady",
            "shaken",
            "frozen",
            "routing",
            "recovering"
          ]
        },
        "escaped": {
          "type": "boolean"
        },
        "routeExitId": {
          "$ref": "#/$defs/id"
        },
        "memoryActorIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "memoryAges": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "toolReady": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toolAvailable": {
          "type": "boolean"
        },
        "engagementHeadroom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "abstractTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "reachM",
        "readiness",
        "concealment",
        "durability",
        "defensiveUtility",
        "intimidation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "class": {
          "enum": [
            "none",
            "barrier",
            "signal",
            "short-reach",
            "long-reach"
          ]
        },
        "reachM": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "concealment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "durability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "defensiveUtility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "intimidation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "environmentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambientLight",
        "ambientNoise",
        "visibilityScale"
      ],
      "properties": {
        "ambientLight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambientNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visibilityScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "randomStreamState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "increment",
        "draws"
      ],
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "increment": {
          "type": "string",
          "pattern": "^[a-f0-9]{15}[13579bdf]$"
        },
        "draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      }
    }
  }
}
